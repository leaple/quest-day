{
  "name": "quest-day-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "QUEST DAY mobile packaging",
  "scripts": {
    "build:web": "node scripts/build-mobile-web.mjs",
    "check:web": "node scripts/build-mobile-web.mjs --check",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build:web && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
